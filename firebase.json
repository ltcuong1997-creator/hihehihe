{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "index.backup.html",
      "1.png",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "data/**",
      "*.md",
      ".git",
      ".git/**",
      ".firebase",
      ".firebase/**",
      ".gitignore",
      ".firebaserc",
      ".claude/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}