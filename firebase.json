{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "index.backup.html",
      "1.png",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "data/**",
      "*.md",
      ".git",
      ".git/**",
      ".firebase",
      ".firebase/**",
      ".gitignore",
      ".firebaserc",
      ".claude/**",
      "robot/**",
      ".github/**",
      "package.json",
      "package-lock.json",
      "firestore.indexes.json",
      "tools/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/app.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}